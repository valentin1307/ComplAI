  <p class="footer-r en">© 2026 ComplyAI · Vienna</p>
</footer>

<script>
// ── LANGUAGE TOGGLE ──
let lang = 'de';
function toggleLang(){
  lang = lang==='de'?'en':'de';
  document.body.classList.toggle('lang-en', lang==='en');
  document.getElementById('langBtn').textContent = lang==='de'?'EN':'DE';
  renderStep();
}

// ── QUIZ ──
const steps = {
  de:[
    {q:"Wie viele Mitarbeiter hat dein Unternehmen?",opts:[{i:"👤",t:"1–9"},{i:"👥",t:"10–49"},{i:"🏢",t:"50–249"},{i:"🏭",t:"250+"}]},
    {q:"In welcher Branche bist du tätig?",opts:[{i:"💻",t:"Tech / SaaS"},{i:"🛒",t:"Handel / E-Commerce"},{i:"🏥",t:"Gesundheit / Pharma"},{i:"⚙️",t:"Sonstiges"}]},
    {q:"Nutzt du KI-Tools in deinem Unternehmen?",opts:[{i:"✅",t:"Ja, regelmäßig"},{i:"🔄",t:"Manchmal"},{i:"❌",t:"Nein"}]},
    {q:"Hast du eine aktuelle Datenschutzerklärung?",opts:[{i:"✅",t:"Ja, aktuell"},{i:"⚠️",t:"Unsicher"},{i:"❌",t:"Nein / Veraltet"}]},
  ],
  en:[
    {q:"How many employees does your company have?",opts:[{i:"👤",t:"1–9"},{i:"👥",t:"10–49"},{i:"🏢",t:"50–249"},{i:"🏭",t:"250+"}]},
    {q:"What industry are you in?",opts:[{i:"💻",t:"Tech / SaaS"},{i:"🛒",t:"Retail / E-Commerce"},{i:"🏥",t:"Health / Pharma"},{i:"⚙️",t:"Other"}]},
    {q:"Do you use AI tools in your business?",opts:[{i:"✅",t:"Yes, regularly"},{i:"🔄",t:"Sometimes"},{i:"❌",t:"No"}]},
    {q:"Do you have an up-to-date privacy policy?",opts:[{i:"✅",t:"Yes, current"},{i:"⚠️",t:"Not sure"},{i:"❌",t:"No / Outdated"}]},
  ]
};

const results = {
  de:[
    {c:"red",t:"<strong>DSGVO-Pflichten</strong> — Datenschutzerklärung prüfen, AVV mit Dienstleistern überprüfen"},
    {c:"yellow",t:"<strong>AI Act (Art. 4)</strong> — KI-Kompetenznachweis für Mitarbeiter erforderlich seit Feb. 2025"},
    {c:"green",t:"<strong>HGB §325</strong> — Offenlegungspflicht prüfen je nach Rechtsform und Größe"},
  ],
  en:[
    {c:"red",t:"<strong>GDPR obligations</strong> — Review privacy policy, check DPAs with service providers"},
    {c:"yellow",t:"<strong>AI Act (Art. 4)</strong> — AI literacy requirement for employees mandatory since Feb. 2025"},
    {c:"green",t:"<strong>Disclosure obligations</strong> — Check annual report filing based on legal form and size"},
  ]
};

let cur=0;let sel=null;
function renderStep(){
  const s=steps[lang][cur];
  const body=document.getElementById('quizBody');
  const fill=document.getElementById('quizFill');
  const prog=document.getElementById('quizProgress');
  fill.style.width=((cur+1)/4*100)+'%';
  prog.textContent=(cur+1)+' / 4';
  body.innerHTML=`
    <p class="quiz-q">${s.q}</p>
    <div class="quiz-opts">
      ${s.opts.map((o,i)=>`<button class="quiz-opt" onclick="selectOpt(this,${i})"><span class="quiz-opt-icon">${o.i}</span>${o.t}</button>`).join('')}
    </div>
    <button class="quiz-next" id="nextBtn" onclick="nextStep()">${lang==='de'?'Weiter →':'Next →'}</button>
  `;
  sel=null;
}

function selectOpt(el,i){
  document.querySelectorAll('.quiz-opt').forEach(o=>o.classList.remove('selected'));
  el.classList.add('selected');
  sel=i;
  document.getElementById('nextBtn').classList.add('visible');
}

function nextStep(){
  if(sel===null)return;
  if(cur<3){cur++;renderStep();}
  else{showResult();}
}

function showResult(){
  document.getElementById('quizBody').style.display='none';
  document.querySelector('.quiz-header').style.display='none';
  document.querySelector('.quiz-bar').style.display='none';
  const r=document.getElementById('quizResult');
  r.style.display='block';
  const ri=document.getElementById('resultItems');
  ri.innerHTML=results[lang].map(x=>`
    <div class="result-item">
      <div class="result-dot ${x.c}"></div>
      <p>${x.t}</p>
    </div>
  `).join('');
  // re-apply language
  r.querySelectorAll('.de,.en').forEach(el=>{
    el.style.display=(el.classList.contains(lang))?'block':'none';
  });
}

// ── WAITLIST ──
let selPrice='';
function selectPrice(el,p){
  document.querySelectorAll('.price-opt').forEach(o=>o.classList.remove('sel'));
  el.classList.add('sel');selPrice=p;
}
function submitWaitlist(){
  const email=document.getElementById('wlEmail').value;
  if(!email||!email.includes('@'))return;
  document.getElementById('wlForm').style.display='none';
  document.getElementById('wlSuccess').style.display='block';
}

// ── FADE IN ──
const obs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');obs.unobserve(e.target);}});
},{threshold:.1});
document.querySelectorAll('.fi').forEach(el=>obs.observe(el));

// INIT
renderStep();
</script>
</body>
</html>
